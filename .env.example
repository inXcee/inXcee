# ═══════════════════════════════════════════════
# YYS — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın ve doldurun:
#   cp .env.example .env
# ═══════════════════════════════════════════════

# ZORUNLU — güçlü rastgele değer (min 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya-cok-guclu-rastgele-bir-deger-yazin

# Ortam (development | production)
NODE_ENV=development

# Log seviyesi (trace | debug | info | warn | error | fatal | silent)
# Default: development=debug, production=info, test=silent
# LOG_LEVEL=info

# Sunucu portu
PORT=3001

# Veritabanı yolu
# Development: yys.db (proje kökü)
# Production:  /var/data/yys.db (kalıcı disk)
DB_PATH=yys.db

# Yüklenen dosyalar (arıza fotoğrafı, imza vs.)
# Development: uploads (proje kökü)
# Production:  /var/data/uploads (kalıcı disk — restart'ta kaybolmasın)
UPLOADS_DIR=uploads

# Yedek dosyaları
# Production: /var/data/backups
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=7

# Reverse proxy arkasındaki gerçek IP'yi al (Render/Vercel: 1, lokal: loopback)
TRUST_PROXY=loopback

# İzin verilen frontend origin'leri (virgülle ayrılmış)
# Production: https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# Doküman dosyaları (KVKK belgeleri, sözleşmeler vb.)
# Boş bırakılırsa: ${UPLOADS_DIR}/documents
DOCUMENTS_DIR=

# ── E-posta Raporu (opsiyonel) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── WhatsApp (opsiyonel) ──────────────────────
# Eski uçlar (legacy /communications + bazı modüller)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Yeni outbound bildirim gönderici (shared/notifications/whatsapp-send.js)
# Açmak için OUTBOUND=true + API_TOKEN dolu olmalı. Aksi halde no-op.
WHATSAPP_OUTBOUND=false
WHATSAPP_API_TOKEN=

# ── SMS (opsiyonel — şu an Netgsm destekli) ──
# SMS_PROVIDER: 'netgsm' veya boş (= devre dışı)
SMS_PROVIDER=
SMS_USER=
SMS_PASS=
SMS_HEADER=

# ── WebAuthn / Biyometrik Mobil Login ─────────
# Mobile PWA'da parmak izi / Face ID kayıt + login için gerekli.
# WEBAUTHN_RP_ID: site domain'i, port'suz (ör. avskamp.com)
# WEBAUTHN_ORIGIN: tam frontend origin (ör. https://avskamp.com)
# Production'da mutlaka dolu olmalı; localhost defaults sadece geliştirme için.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5174

# ── Off-site Backup (opsiyonel) ──────────────
# Local backup üretildikten sonra çalıştırılacak komut. ${FILE} placeholder
# = backup dosyasının tam yolu. Örnekler:
#   OFFSITE_BACKUP_CMD=rclone copy ${FILE} mydrive:yys-backups/
#   OFFSITE_BACKUP_CMD=aws s3 cp ${FILE} s3://my-bucket/backups/
# 10dk timeout; hata local backup'i etkilemez.
OFFSITE_BACKUP_CMD=

# ── Web Push (opsiyonel) ──────────────────────
# Mobile uygulama kapaliyken bildirim gondermek icin VAPID anahtar cifti.
# Uretmek icin: node backend/scripts/generate-vapid-keys.js
# Public key frontend'e VITE_VAPID_PUBLIC_KEY olarak verilir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:berkayinxce@gmail.com

# ─── Observability ───────────────────────────────────────────────
# Sentry error tracking (sentry.io free tier)
# DSN bos birakilirsa Sentry tamamen devre disi kalir.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Prometheus metrics endpoint koruma token'i
# /api/system/metrics endpoint'i bu token ile Bearer olarak korunur.
# Bos birakilirsa endpoint 503 doner (devre disi).
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=

# ─── Background Job Worker ───────────────────────────────────────
# Push notifications ve diger async isler queue uzerinden gonderilir.
# false ile worker tamamen kapanir (debug icin).
JOB_WORKER_ENABLED=true
JOB_WORKER_INTERVAL_MS=2000
